# HandySend 环境变量配置
# 复制此文件为 .env 并填入实际路径

# ============================================================
# ⚠️ Windows 重要提示
# ohrs 在 Windows 上不支持含空格的路径！
# 必须创建无空格的符号链接：
#   New-Item -ItemType Junction -Path "C:\sdk_link\default" -Target "C:\Program Files\Huawei\DevEco Studio\sdk\default"
# 然后使用符号链接路径
# ============================================================

# 变量引用语法：支持 $VAR 和 ${VAR} 引用已定义的变量
# 含空格的值用单引号包裹，解析时自动剥离引号

# --- Windows 示例 ---

# DevEco Studio 安装路径（其它变量可引用此值）
DEVECO_HOME='C:\Program Files\Huawei\DevEco Studio'

# OHOS NDK 路径（指向 openharmony 目录，不是 native 子目录，需无空格路径）
OHOS_NDK_HOME='C:\sdk_link\default\openharmony'

# Java 路径（DevEco Studio 自带的 JBR，引用 DEVECO_HOME）
JAVA_HOME='$DEVECO_HOME/jbr'

# --- Linux 示例 ---
# 取消注释并填入实际路径：
# DEVECO_HOME='/opt/devecostudio'
# OHOS_NDK_HOME='$DEVECO_HOME/sdk/default/openharmony'
# JAVA_HOME='$DEVECO_HOME/jbr'

# --- Rust 构建架构 ---
# 逗号分隔，值对应 ohrs --arch 参数名。默认 arm64（真机）。需要模拟器时加上 x86_64。
# OHRS_BUILD_ARCHS='arm64'
# OHRS_BUILD_ARCHS='arm64,x86_64'
