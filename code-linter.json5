{
  "files": [
    "**/*.ets"
  ],
  "ignore": [
    "**/src/ohosTest/**/*",
    "**/src/mock/**/*",
    "**/node_modules/**/*",
    "**/oh_modules/**/*",
    "**/build/**/*",
    "**/.preview/**/*",
    "**/localsend_ohrs/package/**/*"
  ],
  "ruleSet": [
    "plugin:@performance/recommended",
    "plugin:@security/recommended",
    "plugin:@previewer/recommended",
    "plugin:@cross-device-app-dev/recommended",
    "plugin:@hw-stylistic/recommended",
    "plugin:@compatibility/recommended",
    "plugin:@correctness/recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "@cross-device-app-dev/color-value": "off",
    // @Env 装饰的变量为只读属性、不允许本地初始化（见官方 @Env 文档），
    // 该规则在本工程的全部命中均为误报，故关闭
    "@previewer/mandatory-default-value-for-local-initialization": "off",
    "@security/no-unsafe-aes": "error",
    "@security/no-unsafe-hash": "error",
    "@security/no-unsafe-mac": "warn",
    "@security/no-unsafe-dh": "error",
    "@security/no-unsafe-dsa": "error",
    "@security/no-unsafe-ecdsa": "error",
    "@security/no-unsafe-rsa-encrypt": "error",
    "@security/no-unsafe-rsa-sign": "error",
    "@security/no-unsafe-rsa-key": "error",
    "@security/no-unsafe-dsa-key": "error",
    "@security/no-unsafe-dh-key": "error",
    "@security/no-unsafe-3des": "error"
  }
}